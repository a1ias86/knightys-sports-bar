# ─── Knighty's Sports Bar: environment variables ──────────────────────────────
# Copy to .env.local for local development. Set real values in Vercel → Settings →
# Environment Variables (separately for Production and Preview). Never commit real values.

# Which environment this is: production | preview | development
APP_ENV=development

# Postgres connection used by the running app (Supabase: "Transaction pooler" URI, port 6543).
DATABASE_URL=postgresql://postgres.PROJECTREF:YOUR-DB-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:6543/postgres
# Max connections per server instance
DB_POOL_MAX=3
# Postgres connection used for migrations/scripts (Supabase: "Session pooler" or direct URI, port 5432).
DIRECT_URL=postgresql://postgres.PROJECTREF:YOUR-DB-PASSWORD@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Secret mixed into every PIN hash (HMAC). 32+ random characters. Generate: openssl rand -hex 32
# Changing it invalidates every PIN, so set it once per environment and keep it safe.
PIN_PEPPER=replace-with-64-hex-characters

# One-time token for the /setup page that issues Jon's and Knighty's first PINs.
# Remove it from Vercel once both admins can log in.
ADMIN_SETUP_TOKEN=replace-with-a-long-random-token

# Shared secret Vercel Cron (and any external scheduler) sends as "Authorization: Bearer <value>".
CRON_SECRET=replace-with-64-hex-characters

# ─── Football data (optional: the app works fully without it) ────────────────
# none | api-football | football-data
FOOTBALL_PROVIDER=none
# API-Football (api-sports.io) key, if FOOTBALL_PROVIDER=api-football
API_FOOTBALL_KEY=
# football-data.org token, if FOOTBALL_PROVIDER=football-data
FOOTBALL_DATA_TOKEN=
# Arsenal's id at the chosen provider (API-Football: 42, football-data.org: 57)
ARSENAL_TEAM_ID=
# Season start year used by the provider, e.g. 2026 for 2026-27
FOOTBALL_SEASON=2026
